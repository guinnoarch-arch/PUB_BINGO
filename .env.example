# Supabase project settings (Project Settings -> API). Only the public anon/publishable key goes here,
# never the service-role/secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: the live link the "Open on phone" QR code should point to.
VITE_PUBLIC_APP_URL=

# Local UI work without a database: in-memory demo data that resets on reload. Never enable in production.
# VITE_DEMO_MODE=true
